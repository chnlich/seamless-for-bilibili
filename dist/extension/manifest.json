{
  "manifest_version": 3,
  "name": "Bilibili 桌面网页抗卡",
  "version": "1.0.0",
  "description": "接管 Bilibili 视频页的媒体分片下载，向播放器请求 120 秒缓冲来减少卡顿；全部在本机内存完成，不改动播放控制。",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Bilibili 抗卡设置",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://live.bilibili.com/*"
      ],
      "js": [
        "source-buffer-shim.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://live.bilibili.com/*"
      ],
      "js": [
        "bank.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://live.bilibili.com/*"
      ],
      "js": [
        "main-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://live.bilibili.com/*"
      ],
      "js": [
        "controller.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ]
}
